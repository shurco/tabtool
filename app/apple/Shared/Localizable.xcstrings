        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インデックス作成が完了するまで待つか、ディスク上でファイルが変更された場合は再読み込みしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인덱싱이 끝날 때까지 기다리거나, 디스크에서 파일이 변경된 경우 파일을 다시 불러오세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poczekaj na zakończenie indeksowania albo wczytaj plik ponownie, jeśli zmienił się na dysku."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
