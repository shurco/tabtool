    },
    "The table will be replaced with the last saved version from disk. The file itself is not changed.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Табліца будзе заменена апошняй захаванай версіяй з дыска. Сам файл не змяняецца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tabelle wird durch die zuletzt gesicherte Version vom Datenträger ersetzt. Die Datei selbst wird nicht geändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The table will be replaced with the last saved version from disk. The file itself is not changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tabla se sustituirá por la última versión guardada en el disco. El archivo en sí no se modifica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tableau sera remplacé par la dernière version enregistrée sur le disque. Le fichier lui-même n’est pas modifié."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tabella verrà sostituita con l’ultima versione salvata su disco. Il file in sé non viene modificato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーブルは、ディスク上の最後に保存されたバージョンに置き換えられます。ファイル自体は変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표가 디스크에 마지막으로 저장된 버전으로 교체됩니다. 파일 자체는 변경되지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabela zostanie zastąpiona ostatnio zachowaną wersją z dysku. Sam plik nie zostanie zmieniony."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Таблицю буде замінено останньою збереженою версією з диска. Сам файл не змінюється."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "表格将被替换为磁盘上最近一次存储的版本。文件本身不会更改。"
          }
        }
      }
    },
    "The text cannot be represented in the selected encoding.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Тэкст немагчыма прадставіць у выбранай кадзіроўцы."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
