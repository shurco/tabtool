    "Your changes will be lost if you don’t save them.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Калі не захаваць змены, яны будуць страчаны."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Änderungen gehen verloren, wenn Sie sie nicht sichern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your changes will be lost if you don’t save them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no los guardas, los cambios se perderán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos modifications seront perdues si vous ne les enregistrez pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se non le salvi, le modifiche andranno perse."
          }
        },
        "ja": {
