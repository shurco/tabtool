    "Your unsaved changes will be discarded. The table will be replaced with the last saved version from disk.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Незахаваныя змены будуць адкінуты. Табліца будзе заменена апошняй захаванай версіяй з дыска."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre nicht gesicherten Änderungen werden verworfen. Die Tabelle wird durch die zuletzt gesicherte Version vom Datenträger ersetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your unsaved changes will be discarded. The table will be replaced with the last saved version from disk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios sin guardar se descartarán. La tabla se sustituirá por la última versión guardada en el disco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos modifications non enregistrées seront abandonnées. Le tableau sera remplacé par la dernière version enregistrée sur le disque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche non salvate verranno scartate. La tabella verrà sostituita con l’ultima versione salvata su disco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未保存の変更は破棄されます。テーブルは、ディスク上の最後に保存されたバージョンに置き換えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장하지 않은 변경 사항은 삭제됩니다. 표가 디스크에 마지막으로 저장된 버전으로 교체됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niezachowane zmiany zostaną odrzucone. Tabela zostanie zastąpiona ostatnio zachowaną wersją z dysku."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Незбережені зміни буде відхилено. Таблицю буде замінено останньою збереженою версією з диска."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未存储的更改将被放弃。表格将被替换为磁盘上最近一次存储的版本。"
          }
        }
      }
    },
    "Revert": {
