    "Indexing is not finished. Save again when it completes.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Індэксаванне не завершана. Захавайце яшчэ раз, калі яно завершыцца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Indexierung ist noch nicht abgeschlossen. Sichern Sie erneut, sobald sie fertig ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Indexing is not finished. Save again when it completes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La indexación no ha terminado. Vuelve a guardar cuando se complete."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’indexation n’est pas terminée. Enregistrez à nouveau une fois qu’elle est terminée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’indicizzazione non è terminata. Salva di nuovo al termine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インデックス作成が完了していません。完了してから、もう一度保存してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인덱싱이 완료되지 않았습니다. 완료된 후 다시 저장하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Indeksowanie nie zostało zakończone. Zachowaj ponownie po jego ukończeniu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Індексування не завершено. Збережіть знову, коли воно завершиться."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "索引尚未完成。完成后请再次存储。"
          }
        }
      }
    },
    "The file changed on disk since it was opened. Reload it before saving.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл быў зменены на дыску пасля адкрыцця. Перазагрузіце яго перад захаваннем."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei wurde auf dem Datenträger geändert, seit sie geöffnet wurde. Laden Sie sie vor dem Sichern neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file changed on disk since it was opened. Reload it before saving."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo cambió en el disco desde que se abrió. Recárgalo antes de guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier a changé sur le disque depuis son ouverture. Rechargez-le avant d’enregistrer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file è cambiato su disco dopo l’apertura. Ricaricalo prima di salvare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを開いてからディスク上で変更されました。保存する前に再読み込みしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 연 이후 디스크에서 변경되었습니다. 저장하기 전에 다시 불러오세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik zmienił się na dysku od momentu jego otwarcia. Wczytaj go ponownie przed zachowaniem."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл змінено на диску після його відкриття. Перезавантажте його перед збереженням."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该文件自打开后在磁盘上发生了更改。请在存储前重新载入。"
          }
        }
      }
    },
    "There is not enough free disk space to save this file.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Недастаткова вольнага месца на дыску, каб захаваць гэты файл."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist nicht genügend freier Speicherplatz zum Sichern dieser Datei vorhanden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is not enough free disk space to save this file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay suficiente espacio libre en el disco para guardar este archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n’y a pas assez d’espace disque disponible pour enregistrer ce fichier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spazio libero su disco insufficiente per salvare questo file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルを保存するための空きディスク容量が足りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일을 저장하기에 디스크 여유 공간이 부족합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak wystarczającej ilości wolnego miejsca na dysku, aby zachować ten plik."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Недостатньо вільного місця на диску, щоб зберегти цей файл."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "磁盘可用空间不足，无法存储此文件。"
          }
        }
      }
    },
    "Saving a large file needs free space of about twice its size.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Для захавання вялікага файла патрэбна прыкладна ўдвая больш вольнага месца, чым яго памер."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Sichern einer großen Datei wird freier Speicherplatz in etwa der doppelten Dateigröße benötigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving a large file needs free space of about twice its size."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar un archivo grande requiere un espacio libre de aproximadamente el doble de su tamaño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement d’un fichier volumineux nécessite un espace libre d’environ deux fois sa taille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per salvare un file di grandi dimensioni serve spazio libero pari a circa il doppio della sua dimensione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大容量ファイルを保存するには、ファイルサイズの約2倍の空き容量が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대용량 파일을 저장하려면 파일 크기의 약 두 배에 해당하는 여유 공간이 필요합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowanie dużego pliku wymaga wolnego miejsca o wielkości około dwukrotności jego rozmiaru."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для збереження великого файлу потрібно приблизно вдвічі більше вільного місця, ніж його розмір."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储大文件需要约两倍于其大小的可用空间。"
          }
        }
      }
    },
