    "Files at or above this size open in large file mode.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы такога памеру і большыя адкрываюцца ў рэжыме вялікага файла."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien ab dieser Größe werden im Modus für große Dateien geöffnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files at or above this size open in large file mode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos de este tamaño o mayores se abren en modo de archivo grande."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers de cette taille ou plus s’ouvrent en mode fichier volumineux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file di queste dimensioni o superiori si aprono in modalità file di grandi dimensioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサイズ以上のファイルは、大容量ファイルモードで開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 크기 이상의 파일은 대용량 파일 모드로 열립니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliki o tym rozmiarze lub większe są otwierane w trybie dużych plików."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файли такого розміру й більші відкриваються в режимі великого файлу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "达到或超过此大小的文件将以大文件模式打开。"
          }
        }
      }
    },
