    "This encoding cannot be opened in large file mode.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэтую кадзіроўку немагчыма адкрыць у рэжыме вялікага файла."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Codierung kann im Modus für große Dateien nicht geöffnet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This encoding cannot be opened in large file mode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta codificación no se puede abrir en el modo de archivo grande."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet encodage ne peut pas être ouvert en mode fichier volumineux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa codifica non può essere aperta in modalità file di grandi dimensioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このエンコーディングは、大容量ファイルモードでは開けません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 인코딩은 대용량 파일 모드에서 열 수 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tego kodowania nie można otworzyć w trybie dużych plików."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це кодування не можна відкрити в режимі великого файлу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大文件模式无法打开此编码的文件。"
          }
        }
      }
    },
    "Large file mode needs a single-character ASCII separator, quote and escape.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рэжым вялікага файла патрабуе раздзяляльніка, двукосся і экранавання з аднаго сімвала ASCII."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Modus für große Dateien erfordert als Trennzeichen, Anführungszeichen und Escape-Zeichen jeweils ein einzelnes ASCII-Zeichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Large file mode needs a single-character ASCII separator, quote and escape."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo de archivo grande requiere un separador, unas comillas y un escape ASCII de un solo carácter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode fichier volumineux requiert un séparateur, un guillemet et un échappement ASCII d’un seul caractère."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modalità file di grandi dimensioni richiede un separatore, virgolette ed escape ASCII di un solo carattere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大容量ファイルモードには、1文字のASCIIの区切り文字、引用符、エスケープ文字が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대용량 파일 모드에는 한 글자 ASCII 구분 기호, 따옴표, 이스케이프 문자가 필요합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryb dużych plików wymaga, aby separator, cudzysłów i znak ucieczki były pojedynczymi znakami ASCII."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим великого файлу потребує роздільника, лапок і екранування з одного символу ASCII."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大文件模式需要单字符的 ASCII 分隔符、引号和转义字符。"
          }
        }
      }
    },
