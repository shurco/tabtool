    "Use the arrow keys to move between cells. Press Return to edit the selected cell.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выкарыстоўвайце клавішы са стрэлкамі для перамяшчэння паміж ячэйкамі. Націсніце Return, каб рэдагаваць выбраную ячэйку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit den Pfeiltasten bewegen Sie sich zwischen den Zellen. Drücken Sie den Zeilenschalter, um die ausgewählte Zelle zu bearbeiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the arrow keys to move between cells. Press Return to edit the selected cell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa las teclas de flecha para moverte entre celdas. Pulsa Retorno para editar la celda seleccionada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez les touches fléchées pour passer d’une cellule à l’autre. Appuyez sur Retour pour modifier la cellule sélectionnée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa i tasti freccia per spostarti tra le celle. Premi A capo per modificare la cella selezionata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "矢印キーでセル間を移動します。Returnキーを押すと、選択したセルを編集できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화살표 키로 셀 사이를 이동합니다. Return 키를 누르면 선택한 셀을 편집할 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj klawiszy strzałek, aby przechodzić między komórkami. Naciśnij Return, aby edytować zaznaczoną komórkę."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавішами зі стрілками переходьте між комірками. Натисніть Return, щоб редагувати вибрану комірку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用方向键在单元格之间移动。按下 Return 键以编辑所选单元格。"
          }
        }
      }
    },
