    "Takes effect after restart.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Уступіць у сілу пасля перазапуску."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird nach einem Neustart wirksam."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Takes effect after restart."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Surtirá efecto al reiniciar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prend effet après redémarrage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha effetto dopo il riavvio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再起動後に有効になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 시작한 후에 적용됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiana zacznie obowiązywać po ponownym uruchomieniu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Набуде чинності після перезапуску."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新启动后生效。"
          }
        }
      }
    },
    "The document changed while it was being re-read, so the new format was not applied. Try again.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Дакумент змяніўся падчас перачытвання, таму новы фармат не ўжыты. Паспрабуйце яшчэ раз."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Dokument wurde während des erneuten Einlesens geändert, daher wurde das neue Format nicht angewendet. Versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The document changed while it was being re-read, so the new format was not applied. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El documento cambió mientras se volvía a leer, por lo que no se aplicó el nuevo formato. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le document a changé pendant sa relecture, le nouveau format n’a donc pas été appliqué. Réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il documento è cambiato durante la rilettura, quindi il nuovo formato non è stato applicato. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書類の読み込み直し中に書類が変更されたため、新しいフォーマットは適用されませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 읽는 동안 문서가 변경되어 새 형식이 적용되지 않았습니다. 다시 시도하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokument zmienił się podczas ponownego odczytu, więc nowy format nie został zastosowany. Spróbuj ponownie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Документ змінився під час перечитування, тому новий формат не застосовано. Спробуйте ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该文稿在重新读取时发生了更改，因此未应用新格式。请重试。"
          }
        }
      }
    },
    "The document changed while the operation was running. Try again.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Дакумент змяніўся падчас выканання аперацыі. Паспрабуйце яшчэ раз."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Dokument wurde während des Vorgangs geändert. Versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The document changed while the operation was running. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El documento cambió mientras se ejecutaba la operación. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le document a changé pendant l’exécution de l’opération. Réessayez."
