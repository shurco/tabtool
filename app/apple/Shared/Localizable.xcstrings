    "Undo the edit that added the text, or export with an encoding that can represent it.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Скасуйце рэдагаванне, якое дадало тэкст, або экспартуйце ў кадзіроўцы, якая можа яго прадставіць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Widerrufen Sie die Änderung, mit der der Text hinzugefügt wurde, oder exportieren Sie mit einer Codierung, die ihn darstellen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo the edit that added the text, or export with an encoding that can represent it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deshaz la edición que añadió el texto o exporta con una codificación que pueda representarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulez la modification qui a ajouté le texte ou exportez avec un encodage capable de le représenter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulla la modifica che ha aggiunto il testo oppure esporta con una codifica in grado di rappresentarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストを追加した編集を取り消すか、そのテキストを表現できるエンコーディングで書き出してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트를 추가한 편집을 실행 취소하거나, 해당 텍스트를 표현할 수 있는 인코딩으로 내보내세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cofnij zmianę, która dodała tekst, albo wyeksportuj w kodowaniu, które potrafi go przedstawić."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скасуйте редагування, яке додало текст, або експортуйте в кодуванні, що може його подати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请撤销添加该文本的编辑，或使用可表示该文本的编码导出。"
          }
        }
      }
    },
    "Undo the edit that added the separator or line break, or export with quotes on.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Скасуйце рэдагаванне, якое дадало раздзяляльнік ці разрыў радка, або экспартуйце з уключаным двукоссем."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Widerrufen Sie die Änderung, mit der das Trennzeichen oder der Zeilenumbruch hinzugefügt wurde, oder exportieren Sie mit eingeschalteten Anführungszeichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo the edit that added the separator or line break, or export with quotes on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deshaz la edición que añadió el separador o el salto de línea, o exporta con las comillas activadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulez la modification qui a ajouté le séparateur ou le saut de ligne, ou exportez avec les guillemets activés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulla la modifica che ha aggiunto il separatore o l’interruzione di riga oppure esporta con le virgolette attivate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "区切り文字または改行を追加した編集を取り消すか、引用符をオンにして書き出してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구분 기호 또는 줄 바꿈을 추가한 편집을 실행 취소하거나, 따옴표를 켠 상태로 내보내세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cofnij zmianę, która dodała separator lub podział wiersza, albo wyeksportuj z włączonymi cudzysłowami."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скасуйте редагування, що додало роздільник чи розрив рядка, або експортуйте з увімкненими лапками."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请撤销添加分隔符或换行符的编辑，或在打开引号的情况下导出。"
          }
        }
      }
    },
    "Large file mode. You can browse and edit cells. Sorting, adding, deleting or moving rows and columns, renaming columns, changing the decimal mark and exporting are not available for files this size.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Рэжым вялікага файла. Можна праглядаць і рэдагаваць ячэйкі. Сартаванне, даданне, выдаленне ці перамяшчэнне радкоў і слупкоў, перайменаванне слупкоў, змена дзесятковага знака і экспарт недаступныя для файлаў такога памеру."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modus für große Dateien. Sie können Zellen ansehen und bearbeiten. Sortieren, Hinzufügen, Löschen oder Verschieben von Zeilen und Spalten, Umbenennen von Spalten, Ändern des Dezimaltrennzeichens und Exportieren sind bei Dateien dieser Größe nicht verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Large file mode. You can browse and edit cells. Sorting, adding, deleting or moving rows and columns, renaming columns, changing the decimal mark and exporting are not available for files this size."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo de archivo grande. Puedes explorar y editar celdas. La ordenación, la adición, la eliminación o el movimiento de filas y columnas, el cambio de nombre de las columnas, el cambio del separador decimal y la exportación no están disponibles para archivos de este tamaño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode fichier volumineux. Vous pouvez parcourir et modifier les cellules. Le tri, l’ajout, la suppression ou le déplacement de lignes et de colonnes, le renommage des colonnes, la modification du séparateur décimal et l’exportation ne sont pas disponibles pour les fichiers de cette taille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modalità file di grandi dimensioni. Puoi sfogliare e modificare le celle. Ordinamento, aggiunta, eliminazione o spostamento di righe e colonne, ridenominazione delle colonne, modifica del separatore decimale ed esportazione non sono disponibili per file di queste dimensioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大容量ファイルモードです。セルの閲覧と編集ができます。このサイズのファイルでは、並べ替え、行や列の追加・削除・移動、列の名前の変更、小数点の変更、書き出しは利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대용량 파일 모드입니다. 셀을 둘러보고 편집할 수 있습니다. 이 크기의 파일에서는 정렬, 행과 열의 추가·삭제·이동, 열 이름 변경, 소수점 변경, 내보내기를 사용할 수 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryb dużych plików. Możesz przeglądać i edytować komórki. Sortowanie, dodawanie, usuwanie i przenoszenie wierszy oraz kolumn, zmiana nazw kolumn, zmiana separatora dziesiętnego i eksport nie są dostępne dla plików tego rozmiaru."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим великого файлу. Можна переглядати та редагувати комірки. Сортування, додавання, видалення чи переміщення рядків і стовпців, перейменування стовпців, зміна десяткового роздільника та експорт недоступні для файлів такого розміру."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大文件模式。您可以浏览和编辑单元格。此大小的文件不支持排序、添加、删除或移动行和列、重命名列、更改小数点以及导出。"
          }
        }
      }
    },
    "New rows were appended. Reload to see them.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Дададзены новыя радкі. Перазагрузіце, каб убачыць іх."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurden neue Zeilen angehängt. Laden Sie die Datei neu, um sie anzuzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New rows were appended. Reload to see them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se han añadido filas nuevas. Recarga para verlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De nouvelles lignes ont été ajoutées. Rechargez pour les afficher."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono state aggiunte nuove righe. Ricarica per visualizzarle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい行が追加されました。再読み込みして確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 행이 추가되었습니다. 다시 불러와서 확인하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dołączono nowe wiersze. Wczytaj ponownie, aby je zobaczyć."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додано нові рядки. Перезавантажте, щоб побачити їх."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已追加新行。请重新载入以查看。"
          }
        }
      }
    },
    "The file changed on disk. Reload to continue.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл быў зменены на дыску. Перазагрузіце, каб працягнуць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei wurde auf dem Datenträger geändert. Laden Sie sie neu, um fortzufahren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file changed on disk. Reload to continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo cambió en el disco. Recarga para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier a changé sur le disque. Rechargez pour continuer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file è cambiato su disco. Ricarica per continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルがディスク上で変更されました。続けるには再読み込みしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스크의 파일이 변경되었습니다. 계속하려면 다시 불러오세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik zmienił się na dysku. Wczytaj ponownie, aby kontynuować."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл змінено на диску. Перезавантажте, щоб продовжити."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "磁盘上的文件已更改。请重新载入以继续。"
          }
        }
      }
    },
