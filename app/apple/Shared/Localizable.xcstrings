    "A cell contains the separator or a line break, but quotes are off.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Ячэйка змяшчае раздзяляльнік або разрыў радка, але двукоссе выключана."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Zelle enthält das Trennzeichen oder einen Zeilenumbruch, aber Anführungszeichen sind ausgeschaltet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A cell contains the separator or a line break, but quotes are off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una celda contiene el separador o un salto de línea, pero las comillas están desactivadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une cellule contient le séparateur ou un saut de ligne, mais les guillemets sont désactivés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cella contiene il separatore o un’interruzione di riga, ma le virgolette sono disattivate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セルに区切り文字または改行が含まれていますが、引用符がオフになっています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "셀에 구분 기호 또는 줄 바꿈이 있지만 따옴표가 꺼져 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Komórka zawiera separator lub podział wiersza, ale cudzysłowy są wyłączone."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Комірка містить роздільник або розрив рядка, але лапки вимкнено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有单元格包含分隔符或换行符，但引号已关闭。"
          }
        }
      }
    },
    "A quote character appears inside an unquoted field.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сімвал двукосся сустракаецца ўнутры поля без двукосся."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Anführungszeichen kommt in einem Feld ohne Anführungszeichen vor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A quote character appears inside an unquoted field."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece un carácter de comillas dentro de un campo sin comillas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un guillemet apparaît dans un champ sans guillemets."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un carattere virgolette compare all’interno di un campo senza virgolette."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "引用符で囲まれていないフィールド内に引用符があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "따옴표로 묶이지 않은 필드 안에 따옴표 문자가 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znak cudzysłowu występuje wewnątrz pola bez cudzysłowów."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Символ лапок трапляється всередині поля без лапок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未加引号的字段中出现了引号字符。"
          }
        }
      }
    },
    "A quoted field is not closed or ends with an incomplete escape.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Поле ў двукоссі не закрыта або заканчваецца няпоўным экранаваннем."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein in Anführungszeichen gesetztes Feld ist nicht geschlossen oder endet mit einem unvollständigen Escape-Zeichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A quoted field is not closed or ends with an incomplete escape."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un campo entre comillas no está cerrado o termina con un escape incompleto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un champ entre guillemets n’est pas fermé ou se termine par un échappement incomplet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un campo tra virgolette non è chiuso o termina con un carattere di escape incompleto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "引用符で囲まれたフィールドが閉じられていないか、不完全なエスケープで終わっています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "따옴표로 묶인 필드가 닫히지 않았거나 불완전한 이스케이프로 끝납니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pole w cudzysłowie nie jest zamknięte lub kończy się niepełnym znakiem ucieczki."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поле в лапках не закрито або закінчується неповним екрануванням."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "带引号的字段未闭合，或以不完整的转义字符结尾。"
          }
        }
      }
    },
