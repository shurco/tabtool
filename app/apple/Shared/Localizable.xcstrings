    "Check that the file still exists and that you have permission to open it.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пераканайцеся, што файл усё яшчэ існуе і што ў вас ёсць дазвол на яго адкрыццё."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellen Sie sicher, dass die Datei noch vorhanden ist und Sie die Berechtigung zum Öffnen haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that the file still exists and that you have permission to open it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que el archivo siga existiendo y que tengas permiso para abrirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que le fichier existe toujours et que vous avez l’autorisation de l’ouvrir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica che il file esista ancora e di avere il permesso di aprirlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルが存在していることと、開く権限があることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일이 아직 있는지, 그리고 파일을 열 권한이 있는지 확인하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź, czy plik nadal istnieje i czy masz uprawnienia do jego otwarcia."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переконайтеся, що файл усе ще існує і що у вас є дозвіл на його відкриття."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
