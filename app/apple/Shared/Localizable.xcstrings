          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo non può essere rappresentato nella codifica selezionata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したエンコーディングでは、テキストを表現できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 인코딩으로는 텍스트를 표현할 수 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tego tekstu nie można przedstawić w wybranym kodowaniu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст не можна подати у вибраному кодуванні."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选编码无法表示该文本。"
          }
        }
      }
    },
    "These apply to new documents. Opened files keep the format detected from their content.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэтыя параметры ўжываюцца да новых дакументаў. Адкрытыя файлы захоўваюць фармат, вызначаны па іх змесціве."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Einstellungen gelten für neue Dokumente. Geöffnete Dateien behalten das anhand ihres Inhalts erkannte Format."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These apply to new documents. Opened files keep the format detected from their content."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplican a los documentos nuevos. Los archivos abiertos conservan el formato detectado a partir de su contenido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces réglages s’appliquent aux nouveaux documents. Les fichiers ouverts conservent le format détecté à partir de leur contenu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si applicano ai nuovi documenti. I file aperti mantengono il formato rilevato dal loro contenuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらは新規書類に適用されます。開いたファイルは、内容から検出されたフォーマットのままになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 설정은 새로운 문서에 적용됩니다. 열려 있는 파일은 내용에서 감지된 형식을 유지합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te ustawienia dotyczą nowych dokumentów. Otwierane pliki zachowują format wykryty na podstawie ich zawartości."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ці параметри застосовуються до нових документів. Відкриті файли зберігають формат, визначений за їхнім вмістом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些设置适用于新建文稿。已打开的文件会保留根据其内容检测到的格式。"
          }
        }
      }
    },
    "This document can’t be saved in its current encoding.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэты дакумент немагчыма захаваць у бягучай кадзіроўцы."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Dokument kann nicht in der aktuellen Codierung gesichert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This document can’t be saved in its current encoding."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este documento no se puede guardar con su codificación actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce document ne peut pas être enregistré dans son encodage actuel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare questo documento con la codifica attuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この書類は現在のエンコーディングでは保存できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 문서는 현재 인코딩으로 저장할 수 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tego dokumentu nie można zachować w bieżącym kodowaniu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей документ не можна зберегти в поточному кодуванні."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法以当前编码存储此文稿。"
          }
        }
      }
    },
    "This document can’t be saved with quotes off.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэты дакумент немагчыма захаваць пры выключаным двукоссі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Dokument kann nicht mit ausgeschalteten Anführungszeichen gesichert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This document can’t be saved with quotes off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este documento no se puede guardar con las comillas desactivadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce document ne peut pas être enregistré avec les guillemets désactivés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare questo documento con le virgolette disattivate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この書類は引用符をオフにしたままでは保存できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 문서는 따옴표를 끈 상태로 저장할 수 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tego dokumentu nie można zachować z wyłączonymi cudzysłowami."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей документ не можна зберегти з вимкненими лапками."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法在引号关闭的情况下存储此文稿。"
          }
        }
      }
    },
