    "Quotes are off and a header or cell contains the separator or a line break. The exported file may not read back as the same table.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Двукоссе выключана, а загаловак або ячэйка змяшчае раздзяляльнік ці разрыў радка. Экспартаваны файл можа не прачытацца як тая самая табліца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anführungszeichen sind ausgeschaltet, und eine Kopfzeile oder Zelle enthält das Trennzeichen oder einen Zeilenumbruch. Die exportierte Datei ergibt beim erneuten Öffnen möglicherweise nicht dieselbe Tabelle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quotes are off and a header or cell contains the separator or a line break. The exported file may not read back as the same table."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las comillas están desactivadas y un encabezado o una celda contiene el separador o un salto de línea. Es posible que el archivo exportado no se lea de nuevo como la misma tabla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les guillemets sont désactivés et un en-tête ou une cellule contient le séparateur ou un saut de ligne. Le fichier exporté pourrait ne pas être relu comme le même tableau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le virgolette sono disattivate e un’intestazione o una cella contiene il separatore o un’interruzione di riga. Il file esportato potrebbe non essere riletto come la stessa tabella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "引用符がオフで、ヘッダまたはセルに区切り文字か改行が含まれています。書き出したファイルを読み込むと、元と同じテーブルにならない可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "따옴표가 꺼져 있고 머리글이나 셀에 구분 기호 또는 줄 바꿈이 있습니다. 내보낸 파일을 다시 읽으면 같은 표가 되지 않을 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cudzysłowy są wyłączone, a nagłówek lub komórka zawiera separator albo podział wiersza. Wyeksportowany plik może nie zostać odczytany jako ta sama tabela."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лапки вимкнено, а заголовок або комірка містить роздільник чи розрив рядка. Експортований файл може не прочитатися як та сама таблиця."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "引号已关闭，且表头或单元格包含分隔符或换行符。导出的文件重新读取后可能与原表格不同。"
          }
        }
      }
    },
