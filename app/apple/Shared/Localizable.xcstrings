    "Wait for indexing to finish, or reload the file if it changed on disk.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Дачакайцеся завяршэння індэксавання або перазагрузіце файл, калі ён змяніўся на дыску."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten Sie, bis die Indexierung abgeschlossen ist, oder laden Sie die Datei neu, falls sie auf dem Datenträger geändert wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait for indexing to finish, or reload the file if it changed on disk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera a que termine la indexación o recarga el archivo si cambió en el disco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendez la fin de l’indexation ou rechargez le fichier s’il a changé sur le disque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendi il termine dell’indicizzazione oppure ricarica il file se è cambiato su disco."
          }
