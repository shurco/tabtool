    "Turn quotes on, or remove separators and line breaks from cells.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Уключыце двукоссе або выдаліце раздзяляльнікі і разрывы радкоў з ячэек."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalten Sie die Anführungszeichen ein, oder entfernen Sie Trennzeichen und Zeilenumbrüche aus den Zellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn quotes on, or remove separators and line breaks from cells."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa las comillas o elimina los separadores y saltos de línea de las celdas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez les guillemets ou supprimez les séparateurs et les sauts de ligne dans les cellules."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva le virgolette oppure rimuovi separatori e interruzioni di riga dalle celle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "引用符をオンにするか、セルから区切り文字と改行を削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "따옴표를 켜거나 셀에서 구분 기호와 줄 바꿈을 제거하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz cudzysłowy albo usuń separatory i podziały wierszy z komórek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть лапки або видаліть роздільники й розриви рядків із комірок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请打开引号，或从单元格中移除分隔符和换行符。"
          }
        }
      }
    },
    "Undo Last Edit": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Скасаваць апошняе рэдагаванне"
