#!/usr/bin/env bash
# Builds, runs, and tests the macOS and iOS apps through XcodeGen and xcodebuild.
# Usage: ./scripts/app <run|build|archive|test|clean|version> ...
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "${here}/.." && pwd)"
app_dir="${root}/app/apple"
project="${app_dir}/TabTool.xcodeproj"
build_dir="${app_dir}/build"
derived_data="${build_dir}/DerivedData"

# shellcheck source=scripts/_helper
source "${here}/_helper"
# shellcheck source=scripts/lib/version
source "${here}/lib/version"

usage() {
  cat <<'EOF'
Usage:
  scripts/app run [macos|ios] [--bump-version[=KIND]]
  scripts/app build [macos|ios] [--bump-version[=KIND]]
  scripts/app test ios
  scripts/app archive [macos] [--bump-version[=KIND]]
  scripts/app clean
  scripts/app version [macos|ios]
  scripts/app version bump [macos|ios] [KIND]

KIND is build (default), patch, minor, or major. A bare --bump-version
bumps the build number. run, build, test, and archive regenerate the Xcode
project from app/apple/project.yml first. archive is macOS-only. Mac unit
tests stay on ./scripts/test.
EOF
}

require_tools() {
  if ! command_exists xcodegen; then
    print_answer "xcodegen not found — brew install xcodegen" red
    exit 1
  fi
  if ! command_exists xcodebuild; then
    print_answer "xcodebuild not found — install Xcode" red
    exit 1
  fi
}

generate_project() {
  (cd "${app_dir}" && xcodegen generate)
}

# Sets APP_VERSION_NAME and APP_VERSION_BUILD and builds the xcodebuild
# overrides used by every build command.
version_settings=()
load_version() {
  local platform="$1"
  if ! APP_DIR="${app_dir}" version_configure "${platform}"; then
    exit 1
  fi
  version_settings=()
  if [ -n "${APP_VERSION_NAME}" ]; then
    version_settings+=("MARKETING_VERSION=${APP_VERSION_NAME}")
  fi
  if [ -n "${APP_VERSION_BUILD}" ]; then
    version_settings+=("CURRENT_PROJECT_VERSION=${APP_VERSION_BUILD}")
  fi
}

bump_version() {
  local platform="$1"
  local kind="$2"
  if ! valid_bump_kind "${kind}"; then
    print_answer "Bump kind must be build, patch, minor, or major" red
    exit 1
  fi
  if ! APP_DIR="${app_dir}" version_bump "${platform}" "${kind}"; then
    exit 1
  fi
}

build_app() {
  local configuration="$1"
  local scheme="$2"
  local destination="$3"
  shift 3
  xcodebuild \
    -project "${project}" \
    -scheme "${scheme}" \
    -configuration "${configuration}" \
    -destination "${destination}" \
    -derivedDataPath "${derived_data}" \
    "$@" \
    ${version_settings[@]+"${version_settings[@]}"} \
    build
}

run_app() {
  load_version macos
  generate_project
  build_app Debug TabTool "platform=macOS"
  local app_path="${derived_data}/Build/Products/Debug/TabTool.app"
  if [ ! -d "${app_path}" ]; then
    print_answer "Built app not found at ${app_path}" red
    exit 1
  fi
  open "${app_path}"
}

archive_app() {
  load_version macos
  generate_project
  xcodebuild \
    -project "${project}" \
    -scheme TabTool \
    -configuration Release \
    -destination "platform=macOS" \
    -derivedDataPath "${derived_data}" \
    -archivePath "${build_dir}/TabTool.xcarchive" \
    CODE_SIGNING_ALLOWED=NO \
    ${version_settings[@]+"${version_settings[@]}"} \
    archive
  print_answer "Archive: ${build_dir}/TabTool.xcarchive" green
}

clean_build() {
  rm -rf "${build_dir}"
  print_answer "Removed ${build_dir}" grey
}

# The first available iPhone simulator. Prints its UDID, or returns 1.
ios_simulator_udid() {
  python3 - <<'PY'
import json, subprocess, sys
raw = subprocess.check_output(["xcrun", "simctl", "list", "devices", "available", "-j"])
devices = json.loads(raw).get("devices", {})
for runtime, entries in devices.items():
    if "iOS" not in runtime:
        continue
    for device in entries:
        name = device.get("name", "")
        if name.startswith("iPhone") and device.get("isAvailable") and device.get("udid"):
            print(device["udid"])
            sys.exit(0)
sys.exit(1)
PY
}

require_ios_simulator() {
  local udid
  if ! udid="$(ios_simulator_udid)"; then
    print_answer "No iPhone simulator is available. Install an iOS simulator." red
    exit 1
  fi
  printf '%s\n' "${udid}"
}

boot_ios_simulator() {
  local udid="$1"
  xcrun simctl boot "${udid}" >/dev/null 2>&1 || true
  xcrun simctl bootstatus "${udid}" -b
}

run_ios() {
  local udid app_path
  udid="$(require_ios_simulator)"
  load_version ios
  generate_project
  build_app Debug TabToolIOS "id=${udid}" CODE_SIGNING_ALLOWED=NO
  boot_ios_simulator "${udid}"
  app_path="${derived_data}/Build/Products/Debug-iphonesimulator/TabTool.app"
  if [ ! -d "${app_path}" ]; then
    print_answer "Built app not found at ${app_path}" red
    exit 1
  fi
  xcrun simctl install "${udid}" "${app_path}"
  xcrun simctl launch "${udid}" app.shurco.tabtool
}

test_ios() {
  local udid
  udid="$(require_ios_simulator)"
  load_version ios
  generate_project
  boot_ios_simulator "${udid}"
  xcodebuild \
    -project "${project}" \
    -scheme TabToolIOS \
    -configuration Debug \
    -destination "id=${udid}" \
    -derivedDataPath "${derived_data}" \
    CODE_SIGNING_ALLOWED=NO \
    ${version_settings[@]+"${version_settings[@]}"} \
    test
}

bump_kind=""
positional=()
for argument in "$@"; do
  case "${argument}" in
    --bump-version)
      bump_kind="build"
      ;;
    --bump-version=*)
      bump_kind="${argument#--bump-version=}"
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      positional+=("${argument}")
      ;;
  esac
done

command="${positional[0]:-}"
if [ -z "${command}" ]; then
  usage
  exit 1
fi

case "${command}" in
  clean)
    if [ "${#positional[@]}" -ne 1 ] || [ -n "${bump_kind}" ]; then
      print_answer "clean takes no platform or version flags" red
      exit 1
    fi
    clean_build
    ;;

  version)
    if [ "${positional[1]:-}" = "bump" ]; then
      platform="${positional[2]:-macos}"
      kind="${positional[3]:-build}"
      if [ "${#positional[@]}" -gt 4 ]; then
        usage
        exit 1
      fi
      if ! valid_platform "${platform}"; then
        print_answer "Unsupported platform: ${platform} (only macos or ios)" red
        exit 1
      fi
      bump_version "${platform}" "${kind}"
    else
      platform="${positional[1]:-macos}"
      if [ "${#positional[@]}" -gt 2 ]; then
        usage
        exit 1
      fi
      if ! valid_platform "${platform}"; then
        print_answer "Unsupported platform: ${platform} (only macos or ios)" red
        exit 1
      fi
      if [ -n "${bump_kind}" ]; then
        bump_version "${platform}" "${bump_kind}"
      fi
    fi
    load_version "${platform}"
    ;;

  run | build | archive | test)
    platform="${positional[1]:-macos}"
    if [ "${#positional[@]}" -gt 2 ]; then
      usage
      exit 1
    fi
    if [ "${command}" = "test" ] && [ "${platform}" = "macos" ]; then
      print_answer "Mac tests stay on ./scripts/test" red
      exit 1
    fi
    if [ "${command}" = "archive" ] && [ "${platform}" = "ios" ]; then
      print_answer "archive is macOS-only" red
      exit 1
    fi
    if ! valid_platform "${platform}"; then
      print_answer "Unsupported platform: ${platform} (only macos or ios)" red
      exit 1
    fi
    require_tools
    if [ -n "${bump_kind}" ]; then
      bump_version "${platform}" "${bump_kind}"
    fi
    case "${command}" in
      run)
        if [ "${platform}" = "ios" ]; then
          run_ios
        else
          run_app
        fi
        ;;
      build)
        load_version "${platform}"
        generate_project
        if [ "${platform}" = "ios" ]; then
          build_app Debug TabToolIOS "generic/platform=iOS Simulator" CODE_SIGNING_ALLOWED=NO
        else
          build_app Debug TabTool "platform=macOS" CODE_SIGNING_ALLOWED=NO
        fi
        ;;
      test)
        test_ios
        ;;
      archive)
        archive_app
        ;;
    esac
    ;;

  *)
    print_answer "Unknown command: ${command}" red
    usage
    exit 1
    ;;
esac
